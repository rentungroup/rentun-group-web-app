# Variables de entorno — Rentun Group
# Copia este archivo a .env y completa los valores

# ── Supabase (Públicos del cliente) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Contacto ──
VITE_WA_NUMBER=573219511173
VITE_CONTACT_EMAIL=admin@rentungroup.com

# ── Backend AI & API Keys (Protegidos en servidor, jamás con prefijo VITE_) ──
GROQ_API_KEY=your-groq-api-key-here

# ── SMTP Mailer Backend ──
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-email-password
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
